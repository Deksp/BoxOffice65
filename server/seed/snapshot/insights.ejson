[{"_id":{"$oid":"6954160034731c3cc107747b"},"title":"Идея сравнения","year":null,"createdAt":"2025-12-30T18:12:16.511818+00:00","filmIds":[],"tags":["methodology"],"text":"Удобно сравнивать кассового победителя года с самым дорогим фильмом года: это помогает увидеть, совпадает ли коммерческий успех с масштабом затрат.","updatedAt":"2025-12-30T18:12:16.511814+00:00"},{"_id":{"$oid":"6954160034731c3cc107747c"},"year":null,"title":"Качество данных","createdAt":"2025-12-30T18:12:16.512160+00:00","filmIds":[],"tags":["data-quality"],"text":"Данные о кассовых сборах могут различаться между источниками из-за методик подсчёта и учёта перевыпусков. Для корректного анализа полезно хранить источник/метод получения цифр.","updatedAt":"2025-12-30T18:12:16.512157+00:00"},{"_id":{"$oid":"6954160134731c3cc1077481"},"title":"Домашние сборы и мировые сборы","year":{"$numberInt":"1984"},"createdAt":"2025-12-30T18:12:17.985732+00:00","filmIds":[{"$oid":"695413f434731c3cc10773c5"},{"$oid":"6954160134731c3cc107747d"},{"$oid":"6954160134731c3cc107747f"}],"tags":["comparison","domestic-vs-worldwide"],"text":"Иногда фильм может быть сильнее в одной зоне проката и слабее в другой; из-за этого лидеры по домашним сборам и по мировым сборам не всегда совпадают.","updatedAt":"2025-12-30T18:12:17.985728+00:00"},{"_id":{"$oid":"6954160234731c3cc1077482"},"year":{"$numberInt":"1984"},"title":"Дорогой проект не гарантирует лидерство","createdAt":"2025-12-30T18:12:18.612418+00:00","filmIds":[{"$oid":"695413f434731c3cc10773c7"}],"tags":["budget","comparison"],"text":"Самые дорогие фильмы года не обязательно становятся кассовыми лидерами, поэтому бюджет удобно анализировать отдельно от сборов.","updatedAt":"2025-12-30T18:12:18.612414+00:00"},{"_id":{"$oid":"6954160334731c3cc1077483"},"title":"Окупаемость","year":{"$numberInt":"1970"},"createdAt":"2025-12-30T18:12:19.011769+00:00","filmIds":[{"$oid":"695413c634731c3cc1077385"}],"tags":["roi"],"text":"Бывает, что фильм с относительно небольшим бюджетом собирает непропорционально много: это хороший пример высокой окупаемости (ROI).","updatedAt":"2025-12-30T18:12:19.011764+00:00"},{"_id":{"$oid":"6954160334731c3cc1077484"},"year":{"$numberInt":"2004"},"title":"Касса, бюджет и восприятие","createdAt":"2025-12-30T18:12:19.660957+00:00","filmIds":[{"$oid":"695415eb34731c3cc107741a"},{"$oid":"695415eb34731c3cc107741c"}],"tags":["comparison"],"text":"У конкурентов одного года могут сильно различаться касса, бюджет и рейтинг; такие пары удобно показывать как сравнение внутри года.","updatedAt":"2025-12-30T18:12:19.660951+00:00"},{"_id":{"$oid":"6954160434731c3cc1077486"},"year":{"$numberInt":"1993"},"title":"Перевыпуски меняют картину","createdAt":"2025-12-30T18:12:20.687249+00:00","filmIds":[{"$oid":"6954142334731c3cc10773e9"},{"$oid":"6954143934731c3cc10773fb"}],"tags":["re-releases","history"],"text":"Перевыпуски и длительный прокат способны заметно увеличить итоговые сборы; это важно учитывать при сравнении фильмов разных эпох.","updatedAt":"2025-12-30T18:12:20.687245+00:00"},{"_id":{"$oid":"6954160534731c3cc1077489"},"year":{"$numberInt":"2019"},"title":"Рекорды и пересчёт","createdAt":"2025-12-30T18:12:21.556199+00:00","filmIds":[{"$oid":"695415fb34731c3cc107745d"},{"$oid":"6954160534731c3cc1077487"}],"tags":["records","re-releases","data-quality"],"text":"Гонки за рекордами кассы чувствительны к методике подсчёта и перевыпускам. Полезно хранить альтернативные значения сборов и пометки.","updatedAt":"2025-12-30T18:12:21.556195+00:00"},{"_id":{"$oid":"6954160534731c3cc107748a"},"title":"Нестандартные условия проката","year":{"$numberInt":"2020"},"createdAt":"2025-12-30T18:12:21.884598+00:00","filmIds":[{"$oid":"695415fc34731c3cc1077462"}],"tags":["history","data-quality"],"text":"Периоды с нестандартными условиями проката (например, ограничения) влияют на сборы и сопоставимость данных между годами.","updatedAt":"2025-12-30T18:12:21.884595+00:00"}]