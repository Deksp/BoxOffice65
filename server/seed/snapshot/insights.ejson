[{"_id":{"$oid":"69505dd234731c3cc10771be"},"year":null,"title":"Идея сравнения","createdAt":"2025-12-27T22:29:38.923042+00:00","filmIds":[],"tags":["methodology"],"text":"Удобно сравнивать кассового победителя года с самым дорогим фильмом года: это помогает увидеть, совпадает ли коммерческий успех с масштабом затрат.","updatedAt":"2025-12-27T22:29:38.923036+00:00"},{"_id":{"$oid":"69505dd234731c3cc10771bf"},"title":"Качество данных","year":null,"createdAt":"2025-12-27T22:29:38.923481+00:00","filmIds":[],"tags":["data-quality"],"text":"Данные о кассовых сборах могут различаться между источниками из-за методик подсчёта и учёта перевыпусков. Для корректного анализа полезно хранить источник/метод получения цифр.","updatedAt":"2025-12-27T22:29:38.923476+00:00"},{"_id":{"$oid":"69505dd434731c3cc10771c4"},"year":{"$numberInt":"1984"},"title":"Домашние сборы и мировые сборы","createdAt":"2025-12-27T22:29:40.040140+00:00","filmIds":[{"$oid":"69505db334731c3cc1077108"},{"$oid":"69505dd334731c3cc10771c0"},{"$oid":"69505dd434731c3cc10771c2"}],"tags":["comparison","domestic-vs-worldwide"],"text":"Иногда фильм может быть сильнее в одной зоне проката и слабее в другой; из-за этого лидеры по домашним сборам и по мировым сборам не всегда совпадают.","updatedAt":"2025-12-27T22:29:40.040135+00:00"},{"_id":{"$oid":"69505dd434731c3cc10771c5"},"title":"Дорогой проект не гарантирует лидерство","year":{"$numberInt":"1984"},"createdAt":"2025-12-27T22:29:40.366028+00:00","filmIds":[{"$oid":"69505db334731c3cc107710a"}],"tags":["budget","comparison"],"text":"Самые дорогие фильмы года не обязательно становятся кассовыми лидерами, поэтому бюджет удобно анализировать отдельно от сборов.","updatedAt":"2025-12-27T22:29:40.366024+00:00"},{"_id":{"$oid":"69505dd434731c3cc10771c6"},"year":{"$numberInt":"1970"},"title":"Окупаемость","createdAt":"2025-12-27T22:29:40.767526+00:00","filmIds":[{"$oid":"69505daa34731c3cc10770c8"}],"tags":["roi"],"text":"Бывает, что фильм с относительно небольшим бюджетом собирает непропорционально много: это хороший пример высокой окупаемости (ROI).","updatedAt":"2025-12-27T22:29:40.767521+00:00"},{"_id":{"$oid":"69505dd534731c3cc10771c7"},"title":"Касса, бюджет и восприятие","year":{"$numberInt":"2004"},"createdAt":"2025-12-27T22:29:41.390969+00:00","filmIds":[{"$oid":"69505dc334731c3cc107715d"},{"$oid":"69505dc334731c3cc107715f"}],"tags":["comparison"],"text":"У конкурентов одного года могут сильно различаться касса, бюджет и рейтинг; такие пары удобно показывать как сравнение внутри года.","updatedAt":"2025-12-27T22:29:41.390965+00:00"},{"_id":{"$oid":"69505dd634731c3cc10771c9"},"title":"Перевыпуски меняют картину","year":{"$numberInt":"1993"},"createdAt":"2025-12-27T22:29:42.549219+00:00","filmIds":[{"$oid":"69505dba34731c3cc107712c"},{"$oid":"69505dbd34731c3cc107713e"}],"tags":["re-releases","history"],"text":"Перевыпуски и длительный прокат способны заметно увеличить итоговые сборы; это важно учитывать при сравнении фильмов разных эпох.","updatedAt":"2025-12-27T22:29:42.549215+00:00"},{"_id":{"$oid":"69505dd734731c3cc10771cc"},"year":{"$numberInt":"2019"},"title":"Рекорды и пересчёт","createdAt":"2025-12-27T22:29:43.205563+00:00","filmIds":[{"$oid":"69505dce34731c3cc10771a0"},{"$oid":"69505dd734731c3cc10771ca"}],"tags":["records","re-releases","data-quality"],"text":"Гонки за рекордами кассы чувствительны к методике подсчёта и перевыпускам. Полезно хранить альтернативные значения сборов и пометки.","updatedAt":"2025-12-27T22:29:43.205559+00:00"},{"_id":{"$oid":"69505dd734731c3cc10771cd"},"title":"Нестандартные условия проката","year":{"$numberInt":"2020"},"createdAt":"2025-12-27T22:29:43.513709+00:00","filmIds":[{"$oid":"69505dce34731c3cc10771a5"}],"tags":["history","data-quality"],"text":"Периоды с нестандартными условиями проката (например, ограничения) влияют на сборы и сопоставимость данных между годами.","updatedAt":"2025-12-27T22:29:43.513705+00:00"}]